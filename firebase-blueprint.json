        },
        "sponsors": {
          "type": "string",
          "maxLength": 400
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "sessionId", "title", "sponsors", "notes", "createdAt", "updatedAt"]
    },
    "ProjectorSnapshot": {
      "title": "ProjectorSnapshot",
      "description": "PII-free live stage telemetry mirrored for external synced projector links.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "committeeId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "committeeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "activeTab": {
          "type": "string",
          "enum": ["roll_call", "opening", "motions", "gsl", "mod", "unmod", "cow", "resolutions"]
        },
        "modeDisplayLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "topic": {
          "type": "string",
          "maxLength": 200
        },
        "totalSeconds": { "type": "integer" },
        "speakerSeconds": { "type": "integer" },
        "totalRemainingSeconds": { "type": "integer" },
        "speakerRemainingSeconds": { "type": "integer" },
        "timerRunning": { "type": "boolean" },
        "timerUpdatedAtMs": { "type": "number" },
        "isResReading": { "type": "boolean" },
        "currentSpeakerName": { "type": "string", "maxLength": 100 },
        "currentSpeakerCode": { "type": "string", "maxLength": 10 },
        "yieldType": {
          "type": "string",
          "enum": ["none", "chair", "pois", "delegate", "comments"]
        },
        "upcomingQueue": { "type": "array" },
        "activeTotal": { "type": "integer" },
        "totalDelegations": { "type": "integer" },
        "pvCount": { "type": "integer" },
        "quorumNeeded": { "type": "integer" },
        "quorumMet": { "type": "boolean" },
        "simpleMajority": { "type": "integer" },
        "twoThirdsMajority": { "type": "integer" },
        "simpleFractionLabel": { "type": "string", "minLength": 1, "maxLength": 20 },
        "superFractionLabel": { "type": "string", "minLength": 1, "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "committeeId",
        "committeeName",
        "sessionName",
        "activeTab",
        "modeDisplayLabel",
        "topic",
        "totalSeconds",
        "speakerSeconds",
        "totalRemainingSeconds",
        "speakerRemainingSeconds",
        "timerRunning",
        "timerUpdatedAtMs",
        "isResReading",
        "currentSpeakerName",
        "currentSpeakerCode",
        "yieldType",
        "upcomingQueue",
        "activeTotal",
        "totalDelegations",
        "pvCount",
        "quorumNeeded",
        "quorumMet",
        "simpleMajority",
        "twoThirdsMajority",
        "simpleFractionLabel",
        "superFractionLabel",
        "createdAt",
        "updatedAt"
      ]
