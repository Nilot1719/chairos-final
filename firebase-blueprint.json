  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Chair profile document owned strictly by the signed-in user."
    },
    "/committees/{committeeId}": {
      "schema": { "$ref": "#/entities/Committee" },
      "description": "Top-level committee record owned by the creating chair."
    },
    "/committees/{committeeId}/delegates/{delegateId}": {
      "schema": { "$ref": "#/entities/Delegate" },
      "description": "Delegations enrolled in the committee."
    },
    "/committees/{committeeId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Committee sessions and roll call attendance maps."
    },
    "/committees/{committeeId}/motions/{motionId}": {
      "schema": { "$ref": "#/entities/Motion" },
      "description": "Motions proposed and ranked by disruptiveness."
    },
    "/committees/{committeeId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Chronological speech, POI, motion, and amendment logs per delegate."
    },
    "/committees/{committeeId}/caucuses/{caucusMode}": {
      "schema": { "$ref": "#/entities/CaucusState" },
      "description": "Live caucus state for gsl, mod, unmod, cow, or resolutions."
    },
    "/committees/{committeeId}/blocs/{blocId}": {
      "schema": { "$ref": "#/entities/UnmodBloc" },
      "description": "Bloc and working paper notes logged during unmoderated caucuses."
    },
    "/committees/{committeeId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/CommitteeMember" },
      "description": "Verified co-chair membership records inside a committee."
    },
    "/committees/{committeeId}/meta/{metaId}": {
      "schema": { "$ref": "#/entities/CommitteeManifest" },
      "description": "Committee document ID manifest for atomic co-chair permission synchronization."
    },
    "/committeeInvites/{joinCode}": {
      "schema": { "$ref": "#/entities/CommitteeInvite" },
      "description": "4-character uppercase alphanumeric lookup record mapping a join code to a committee."
    },
    "/committeeInvites/{joinCode}/secrets/{secretId}": {
      "schema": { "$ref": "#/entities/CommitteeInviteSecret" },
      "description": "Write-protected password hash lock unreadable by non-owners."
    },
    "/projectors/{projectorId}": {
      "schema": { "$ref": "#/entities/ProjectorSnapshot" },
      "description": "PII-free live stage telemetry readable by capability ID for external projector displays."
    }
  }
}
